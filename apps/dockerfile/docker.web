FROM oven/bun:1-slim AS base
WORKDIR /app

COPY ./packages ./packages
COPY ./bun.lock ./bun.lock

COPY ./package.json ./package.json
COPY ./turbo.json ./turbo.json

COPY  ./apps/web  ./apps/web

RUN bun install 

RUN bun run build

WORKDIR /app/apps/web

EXPOSE 3000

CMD ["bun" , "run" , "start"]


