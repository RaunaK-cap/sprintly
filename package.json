{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=api --filter=websocket --filter=web",
    "dev:backend": "turbo run dev --filter=api --filter=websocket",
    "dev:web": "turbo run dev --filter=web",
    "db:generate": "cd packages/database && bunx prisma generate && cd ../.. ",
    "db:migrate": "cd packages/database && bunx prisma migrate deploy && cd ../.. ",
    "start:backend": " cd apps/api && bun run dev",
    "start:backend:migrate": " bun run db:migrate && bun run start:backend ",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.10.10"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}